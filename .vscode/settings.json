{
  // --- Core Editor Settings ---
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.wordWrap": "on",
  "editor.wordWrapColumn": 80,
  "editor.formatOnSave": true,
  "editor.formatOnPaste": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",

  // --- 1. Guardrail for the 'Generate Commit' Button ---
  "github.copilot.chat.commitMessageGeneration.instructions": [
    {
      "text": "Follow Conventional Commits: 'type(scope): description'. NEVER use the 'add:' prefix. Use imperative mood and UK English."
    }
  ],
  "github.copilot.chat.pullRequestDescriptionGeneration.instructions": [
    {
      "text": "Use '.github/pull_request_template.md' as the absolute structural reference. Fill checkboxes [x] based on changes, use UK English, and maintain an 80-character line wrap."
    },
    {
      "text": "PR titles must use 'type(scope):' (colon). Branch names use 'type/description' (slash). Maintain UK English, BEM (hyphen-case) for CSS, and camelCase for TS."
    },
    {
      "text": "Only use these 14 labels: automated, breaking-change, chore, dependencies, docs, feat, fix, github-actions, in-progress, on-hold, priority: high, refactor, security, test."
    },
    
  ],

  // --- UK English Spellcheck ---
  "cSpell.language": "en-GB",
  "cSpell.enabled": true,
  "cSpell.ignorePaths": ["node_modules/**", "dist/**", "*.min.js"],
  "cSpell.words": ["BEM", "scss", "esbuild", "commitlint", "husky", "ruleset"],

  // --- SCSS & CSS (BEM Focus) ---
  "[scss]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "scss.lint.idSelector": "warning",

  // --- TypeScript (Strict Focus) ---
  "[typescript]": {
    "editor.codeActionsOnSave": { "source.organizeImports": "explicit" }
  },

  // --- Files to Hide ---
  "files.exclude": {
    "**/.git": true,
    "**/*.css.map": true,
    "scripts/*.js": { "when": "$(basename).ts" }
  }
}
